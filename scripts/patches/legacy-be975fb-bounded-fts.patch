+func scoredIDBefore(a, b ScoredID) bool {
+	if a.Score != b.Score {
+		return a.Score > b.Score
+	}
+	return bytes.Compare(a.ID[:], b.ID[:]) < 0
+}
+
+// scoredIDHeap keeps the worst retained result at its root.
+type scoredIDHeap []ScoredID
+
+func (h scoredIDHeap) Len() int { return len(h) }
+func (h scoredIDHeap) Less(i, j int) bool {
+	return scoredIDBefore(h[j], h[i])
+}
+func (h scoredIDHeap) Swap(i, j int) { h[i], h[j] = h[j], h[i] }
+func (h *scoredIDHeap) Push(value any) {
+	*h = append(*h, value.(ScoredID))
+}
+func (h *scoredIDHeap) Pop() any {
+	old := *h
+	last := len(old) - 1
+	value := old[last]
+	*h = old[:last]
+	return value
+}
+
+func topScoredIDs(ctx context.Context, scores map[[16]byte]float64, topK int) ([]ScoredID, error) {
+	if topK <= 0 || len(scores) <= topK {
+		results := make([]ScoredID, 0, len(scores))
+		for id, score := range scores {
+			if err := ctx.Err(); err != nil {
+				return nil, err
+			}
+			results = append(results, ScoredID{ID: id, Score: score})
+		}
+		sortScoredIDs(results)
+		return results, ctx.Err()
+	}
+
+	results := make(scoredIDHeap, 0, topK)
+	for id, score := range scores {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		candidate := ScoredID{ID: id, Score: score}
+		if len(results) < topK {
+			heap.Push(&results, candidate)
+			continue
+		}
+		if scoredIDBefore(candidate, results[0]) {
+			results[0] = candidate
+			heap.Fix(&results, 0)
 		}
 	}
+	sortScoredIDs(results)
+	return results, ctx.Err()
+}
+
+// sortScoredIDs sorts by score descending and ID ascending.
+func sortScoredIDs(s []ScoredID) {
+	sort.Slice(s, func(i, j int) bool { return scoredIDBefore(s[i], s[j]) })
 }
 
